{
  "expo": {
    "name": "Mu'alina",
    "slug": "mualina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mulina.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SmartStitch needs access to your photos to convert them into embroidery patterns.",
        "NSCameraUsageDescription": "SmartStitch needs access to your camera to take photos for patterns."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mulina.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Mu'Alina — Cyfrowy Tamborek i Wzory Haftu",
      "shortName": "Mu'Alina",
      "description": "Profesjonalna aplikacja do haftu krzyżykowego i płaskiego, czytnik schematów i konwerter zdjęć na muliny DMC",
      "themeColor": "#D9777F",
      "backgroundColor": "#FAF7F2",
      "display": "standalone",
      "orientation": "any",
      "scope": "/",
      "startUrl": "/",
      "lang": "pl",
      "preferRelatedApplications": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to convert them into embroidery patterns."
        }
      ]
    ],
    "experiments": {
      "baseUrl": ""
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
